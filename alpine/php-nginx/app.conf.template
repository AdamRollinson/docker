server {
    listen ${NGINX_PORT};
    listen [::]:${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    # Hide Nginx version
    server_tokens off;

    root ${NGINX_DOCUMENT_ROOT};
    index index.php index.html;

    client_max_body_size ${PHP_POST_MAX_SIZE};
    client_body_buffer_size 256k;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;

    # Timeouts
    client_body_timeout 60s;
    client_header_timeout 60s;
    send_timeout 60s;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Health check endpoint (no add_header here so the server-level security headers are inherited)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # Allow ACME HTTP-01 challenges and other RFC 8615 well-known URIs
    location ^~ /.well-known/ {
        try_files @@uri =404;
    }

    # Deny access to hidden files (.env, .git, .htaccess, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        try_files @@uri @@uri/ /index.php?@@query_string;
    }

    location ~ \.php@@ {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass ${NGINX_FASTCGI_PASS};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME @@document_root@@fastcgi_script_name;

        # FastCGI buffer protection
        fastcgi_buffer_size 256k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 512k;
        fastcgi_read_timeout 60s;
        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout 60s;
        fastcgi_intercept_errors on;
    }

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;

    # Server-level drop-ins: mount or COPY into /etc/nginx/after.d; /run/nginx/after.d is for runtime-rendered snippets
    include /etc/nginx/after.d/*.conf;
    include /run/nginx/after.d/*.conf;

    error_log ${NGINX_ERROR_LOG};
    ${NGINX_ACCESS_LOG_DIRECTIVE};
}
