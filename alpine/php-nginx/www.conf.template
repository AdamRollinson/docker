[www]

; Set the user and group
user = nobody
group = nobody

; Listen on a TCP socket
listen = ${PHP_FPM_LISTEN}

; Process management style
pm = dynamic

; Adjust number of child processes based on server resources
pm.max_children = ${PHP_FPM_MAX_CHILDREN}
pm.start_servers = ${PHP_FPM_START_SERVERS}
pm.min_spare_servers = ${PHP_FPM_MIN_SPARE_SERVERS}
pm.max_spare_servers = ${PHP_FPM_MAX_SPARE_SERVERS}

; Limit the number of requests a child process serves
pm.max_requests = ${PHP_FPM_MAX_REQUESTS}

; Error logging is pinned per pool; every other PHP setting comes from php.ini so that
; PHP_* variables and php.<setting> overrides apply equally to CLI and FPM.
; Pin a setting for FPM only with: -e "fpm.pool.php_admin_value[memory_limit]=512M"
php_admin_value[error_log] = ${PHP_FPM_ERROR_LOG}
php_admin_flag[log_errors] = on

; Set open file descriptor limit
rlimit_files = 1024
rlimit_core = 0

; Redirect worker stdout and stderr into the main error log
catch_workers_output = yes
decorate_workers_output = no

; Security settings
clear_env = no
security.limit_extensions = .php

; Adjust slowlog settings for debugging long requests
slowlog = ${PHP_FPM_SLOWLOG}
request_slowlog_timeout = 5s
