# rollogi/frankenphp Caddyfile. Caddy substitutes the {$VAR} placeholders from the environment
# when it loads this file, so it is shipped as is and never rendered. The entrypoint fills in
# FRANKENPHP_CONFIG (worker, threads) and CADDY_LOG_* from the friendlier variables.
# Add site blocks of your own as /etc/frankenphp/Caddyfile.d/*.caddyfile.

{
	skip_install_trust

	log {
		output {$CADDY_LOG_OUTPUT}
		format {$CADDY_LOG_FORMAT}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME} {
	root * {$SERVER_ROOT}
	encode zstd br gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}

	# Health endpoint that never reaches PHP, as in php-nginx
	respond /health "OK" 200

	# Hidden files (.env, .git) are refused; /.well-known/ stays reachable for ACME and friends
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 403

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}

import Caddyfile.d/*.caddyfile
